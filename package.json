{
  "name": "utils",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "workspaces": [
    "packages/**/*"
  ],
  "lint-staged": {
    "*.{yml,yaml,json,md}": "yarn format",
    "packages/**/*.{js,mjs,cjs,jsx,ts,tsx}": [
      "yarn format",
      "yarn lint"
    ],
    "packages/**/src/**/*.{test,spec}.{ts,tsx}": "yarn test unit",
    "packages/**/integration/**/*.{test,spec}.{ts,tsx}": "yarn test integration"
  },
  "devDependencies": {
    "@atls/raijin": "latest",
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@4.18.0"
}
